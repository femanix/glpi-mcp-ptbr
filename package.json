{
  "name": "glpi-rj-mcp",
  "version": "3.3.0",
  "description": "Servidor MCP para GLPI: gestão de serviços de TI para o Claude. Busca com múltiplos critérios, paginação, resolução dinâmica de campos, linha do tempo de chamados, cobertura ITIL (incidentes, problemas, mudanças, validações), CMDB de ativos e relatórios.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "glpi-rj-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "prepublishOnly": "npm run build",
    "test": "tsx --test test/*.test.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "glpi",
    "itsm",
    "itil",
    "helpdesk",
    "service-desk",
    "tickets",
    "incidents",
    "problems",
    "changes",
    "assets",
    "inventory",
    "cmdb",
    "knowledge-base",
    "contracts",
    "projects",
    "claude",
    "anthropic",
    "ai",
    "llm",
    "automation"
  ],
  "author": "femani",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/femanix/glpi-rj-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/femanix/glpi-rj-mcp/issues"
  },
  "homepage": "https://github.com/femanix/glpi-rj-mcp#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsx": "^4.22.4",
    "typescript": "^5.3.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
